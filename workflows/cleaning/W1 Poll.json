    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cfg = {};\nfor (const r of rows) cfg[r.key] = r.value;\n\n// Another run is still working: stop quietly.\nconst until = cfg.poll_lock_until ? Date.parse(cfg.poll_lock_until) : 0;\nconst now = Date.now();\nif (until && until > now) return [];\n\nconst token = cfg.bot_token;\ndelete cfg.bot_token;\nreturn [{ json: {\n  token,\n  offset: Number(cfg.telegram_offset || 0),\n  lock_until: new Date(now + 55000).toISOString(),\n  cfg\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
