    {
      "parameters": {
        "jsCode": "const updates = $('Get updates').first().json.result || [];\nconst people = $('Get people').all().map(i => i.json);\nconst out = [];\nfor (const u of updates) {\n  const m = u.message;\n  if (!m || !m.chat || m.chat.type !== 'private' || !m.from) continue;\n  const id = String(m.from.id);\n  const person = people.find(p => String(p.user_id) === id);\n  const text = m.text || m.caption || '';\n  const photo = m.photo ? m.photo[m.photo.length - 1].file_id : '';\n  out.push({ json: {\n    update_id: String(u.update_id),\n    user_id: id,\n    known: !!person,\n    name: person ? person.name : '',\n    role: person ? person.role : '',\n    text,\n    photo\n  }});\n}\nreturn out;"
      },
